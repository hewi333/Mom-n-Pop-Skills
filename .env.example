# Mom-n-Pop-Skills — Environment Variables Template
#
# Copy this file to .env and fill in ONLY the integrations you use.
# Never commit your real .env file — it's in .gitignore.
# Each skill lists which env vars it needs in its SKILL.md.

# ── Stripe (stripe-payments, stripe-link-cli) ──────────────
# Get from: https://dashboard.stripe.com/apikeys
# Use test mode keys for development, live keys for production
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# ── Mailchimp (mailchimp-integration) ───────────────────────
# Get from: https://admin.mailchimp.com/account/api/
# The server prefix is the last part of your API key (e.g., us17)
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us17
MAILCHIMP_SERVER_PREFIX=us17

# ── Microsoft Graph (outlook-graph) ──────────────────────────
# Get from: Azure Portal → App Registrations → New Registration
# Required only if using real Microsoft 365 (not IMAP)
MS_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MS_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MS_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── QuickBooks Online (quickbooks-online) ────────────────────
# Get from: https://developer.intuit.com → My Apps → Create App
QBO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QBO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QBO_COMPANY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QBO_ENVIRONMENT=production  # or "sandbox"

# ── Google Workspace (construction-agent) ───────────────────
# Get from: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_MAILBOX=info@yourdomain.com

# Google Drive folder IDs for email→Drive→PM pipeline
GOOGLE_DRIVE_RAW_FOLDER_ID=1ABC123xyz
GOOGLE_DRIVE_PROCESSED_FOLDER_ID=1DEF456uvw

# ── JobTread (construction-agent) ────────────────────────────
# Get from: JobTread → Settings → Integrations → API
# Grant keys expire after 3 months of inactivity
JOBTREAD_GRANT_KEY=your_grant_key_here
JOBTREAD_ORG_ID=your_org_id_here

# ── CRM-Lite (crm-lite) ──────────────────────────────────────
# Optional — defaults to ~/.hermes/data/crm.db
# CRM_SQLITE_PATH=/path/to/your/crm.db